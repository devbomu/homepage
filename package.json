{
  "name": "namsu-kim",
  "version": "0.1.0",
  "private": true,
  "description": "namsu.kim — 개인 홈페이지 (Next.js + Hono + Cloudflare D1)",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@namsu/web",
    "dev:admin": "turbo run dev --filter=@namsu/admin",
    "dev:api": "turbo run dev --filter=@namsu/api",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @namsu/db generate",
    "db:migrate:local": "pnpm --filter @namsu/db migrate:local",
    "db:migrate:remote": "pnpm --filter @namsu/db migrate:remote",
    "db:seed:local": "pnpm --filter @namsu/db seed:local",
    "db:studio": "pnpm --filter @namsu/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,astro,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,astro,json,md,yaml,yml,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2"
  }
}
