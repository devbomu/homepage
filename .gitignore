# ---- secrets (공개 저장소: 절대 커밋 금지) ----
.env
.env.*
!.env.example
# Astro 의 PUBLIC_* 는 빌드 시점에 코드로 치환되므로 운영 값이 빌드 환경에 있어야 한다.
# 전부 브라우저에 노출되는 공개 설정이라 커밋해도 된다 (비밀값은 여기 넣지 않는다).
!.env.production
# wrangler 의 로컬 비밀값 파일. 이름이 .env 패턴에 안 걸리므로 따로 적는다.
.dev.vars
.dev.vars.*
!.dev.vars.example
*.local
*.pem
*.key
*.p12
credentials.json
deploy/.env
deploy/backups/

# ---- node ----
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
.vercel/
.wrangler/
.open-next/

# ---- go ----
server/bin/
server/tmp/
*.test
*.out
coverage.*

# ---- 로그 / 임시 ----
*.log
npm-debug.log*
pnpm-debug.log*
tmp/
.cache/

# ---- OS / 에디터 ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# wrangler 로컬 상태 (공유 D1)
.wrangler-state/

# Astro 가 만드는 타입 캐시와 dev 서버 PID 파일.
# `astro sync` / `astro dev` 가 매번 다시 만들므로 저장소에 둘 이유가 없다.
.astro/
