# 로컬 개발용 비밀값. 이 파일을 .dev.vars 로 복사해 채운다.
# .dev.vars 는 .gitignore 에 걸려 있다 — 절대 커밋하지 않는다.

# 방문자 식별 해시의 솔트. 아래로 생성한다:
#   openssl rand -hex 32
VISITOR_HASH_SALT=""

# Turnstile 비밀키. 비워두면 로컬에서는 검증을 건너뛴다.
TURNSTILE_SECRET_KEY=""

# 관리자 이메일 (쉼표 구분). Cloudflare Access 통과 후의 2차 방어선.
# 비워두면 개발 환경에서는 통과시킨다.
ADMIN_EMAILS=""

# 로컬에서는 .dev.vars 가 wrangler.jsonc 의 vars 를 덮어쓴다.
# 이 두 줄이 없으면 운영 설정으로 기동해 필수 비밀값 검사에 걸린다.
ENVIRONMENT="development"
SITE_URL="http://localhost:4321"
ADMIN_URL="http://localhost:5173"
MEDIA_PUBLIC_BASE_URL="http://localhost:8787/media"
