{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namsu-api",
  "main": "src/index.ts",
  // 2026-08-04 이후 날짜라 Node.js 호환이 기본 활성화된다.
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },

  // Access 는 호스트 이름 단위로 적용된다. 커스텀 도메인만 정책으로 감싸면
  // *.workers.dev 주소가 인증 없이 열린 채로 남는다. 아예 만들지 않는다.
  // preview_urls 도 같은 이유로 끈다 (버전마다 공개 URL 이 하나씩 생긴다).
  "workers_dev": false,
  "preview_urls": false,

  "routes": [{ "pattern": "api.namsu.kim", "custom_domain": true }],

  // 발행 시각이 지난 '예약' 항목의 상태를 정리한다.
  // 공개 여부는 쿼리 조건이 결정하므로, 이 크론이 늦어도 글은 제때 공개된다.
  // 관리자 목록의 라벨을 맞추는 용도다.
  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namsu-kim",
      // `wrangler d1 create namsu-kim` 출력값으로 교체한다.
      // D1 database id 는 비밀값이 아니다 (API 토큰 없이는 접근 불가).
      "database_id": "3a8bfd8d-6140-495c-af72-7fe726266d7f",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "namsu-media" }],

  // 좋아요/댓글 남용 방어. D1 에 쓰지 않고 엣지에서 카운트하므로 비용이 들지 않는다.
  // period 는 10 또는 60 만 허용된다.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMIT_WRITE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMIT_COMMENT",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 3, "period": 60 }
      }
    ]
  },

  // 비밀이 아닌 설정만 여기 둔다.
  // 비밀값(TURNSTILE_SECRET_KEY, VISITOR_HASH_SALT, ADMIN_EMAILS)은
  // `wrangler secret put` 으로 주입한다. 공개 저장소이므로 절대 여기 쓰지 않는다.
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://www.namsu.kim",
    // 관리자가 단 답글에 붙는 이름. 비밀값이 아니라 공개 사이트에 그대로 보인다.
    "OWNER_DISPLAY_NAME": "남수",
    // 알림 메일의 발신자. 도메인은 Resend 에서 인증해 두어야 한다.
    // 비밀값이 아니다 — 받는 사람의 메일 헤더에 그대로 찍힌다.
    // RESEND_API_KEY 가 없으면 발송 자체를 건너뛰므로 이 값만으로는 아무 일도 없다.
    "MAIL_FROM": "namsu.kim <no-reply@namsu.kim>",
    "ADMIN_URL": "https://admin.namsu.kim",
    "MEDIA_PUBLIC_BASE_URL": "https://media.namsu.kim",
    // Access 앱의 팀 도메인과 AUD 태그. 둘 다 비밀값이 아니다.
    // 팀 도메인은 로그인 리다이렉트 주소에 그대로 드러나고, AUD 는 JWT 의
    // aud 클레임이라 브라우저도 들고 있다. 이 값을 안다고 토큰을 위조할 수는 없다
    // (서명은 Cloudflare 의 비공개 키로만 만들어진다).
    "CF_ACCESS_TEAM_DOMAIN": "kns-bomu.cloudflareaccess.com",
    "CF_ACCESS_AUD": "6ea8d410705e7f9fde1bc33bda4ce89efa09460756be5601e314d0df12dc470d",
    "COMMENTS_REQUIRE_APPROVAL": "false"
  }
}
