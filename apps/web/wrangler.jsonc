{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namsu-web",
  // 어댑터가 제공하는 엔트리포인트를 가리킨다 (빌드 산출물 경로가 아니다).
  // astro dev 와 배포가 같은 진입점을 쓴다.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  // Astro 의 Cloudflare 어댑터는 세션 저장소로 KV 를 쓴다.
  // 여기서 선언하지 않으면 배포 시 자동 프로비저닝으로 넘어가는데,
  // 그 흐름은 대화형 확인을 물을 수 있어 CI 에서 멈출 수 있다.
  // 아래 id 는 `wrangler kv namespace create SESSION` 출력값으로 교체한다.
  // (이 사이트는 세션을 쓰지 않지만 어댑터가 바인딩을 요구한다.)
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000000000000000000000000000"
    }
  ],

  "routes": [
    { "pattern": "www.namsu.kim", "custom_domain": true },
    { "pattern": "namsu.kim", "custom_domain": true }
  ],

  // PUBLIC_* 는 여기 두지 않는다.
  // Astro 가 빌드 시점에 코드로 치환해 버리므로 런타임 var 로는 바뀌지 않는다.
  // 운영 값은 .env.production 에 있다.
  "vars": {}
}
