---
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { api, type SiteSettings } from '@lib/api';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  /** 글 상세처럼 article 로 표시해야 하는 페이지. */
  ogType?: 'website' | 'article';
  publishedAt?: number | null;
  noindex?: boolean;
  /** 이 페이지의 엣지 캐시 시간(초). 0 이면 캐시하지 않는다. */
  cacheSeconds?: number;
}

const {
  title,
  description,
  ogImage = null,
  ogType = 'website',
  publishedAt = null,
  noindex = false,
  cacheSeconds = 60,
} = Astro.props;

/**
 * 사이트 설정과 네비게이션은 거의 안 바뀌는데 모든 페이지에서 필요하다.
 * API 가 잠깐 죽어도 화면은 떠야 하므로 실패하면 기본값으로 넘어간다.
 */
let settings: SiteSettings = {};
let navItems: { slug: string; label: string }[] = [];
try {
  const [settingsResult, navResult] = await Promise.all([api.site.settings(), api.site.nav()]);
  settings = settingsResult.data ?? {};
  navItems = navResult.data ?? [];
} catch (error) {
  console.error('사이트 설정을 불러오지 못했습니다', error);
}

const siteTitle = settings['site.title'] ?? 'namsu.kim';
const siteDescription = settings['site.description'] ?? '김남수의 개인 홈페이지';
const author = settings['site.author'] ?? '김남수';

const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const pageDescription = description ?? siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/**
 * 엣지 캐시.
 *
 * SSR 이지만 대부분의 페이지는 내용이 자주 바뀌지 않는다.
 * s-maxage 로 Cloudflare 가 받아내게 하고, stale-while-revalidate 로
 * 갱신 중에도 예전 응답을 바로 돌려준다.
 */
if (cacheSeconds > 0) {
  Astro.response.headers.set(
    'Cache-Control',
    `public, max-age=0, s-maxage=${cacheSeconds}, stale-while-revalidate=600`,
  );
}
---

<!doctype html>
<html lang={(settings['site.locale'] as string) ?? 'ko'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteTitle} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogType === 'article' && publishedAt && (
      <meta
        property="article:published_time"
        content={new Date(publishedAt * 1000).toISOString()}
      />
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    <!--
      테마를 그리기 전에 먼저 적용한다.
      이걸 안 하면 다크 모드 사용자에게 흰 화면이 한 번 번쩍인다.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dracula' : 'winter');
        } catch {
          /* localStorage 가 막혀 있어도 기본 테마로 동작해야 한다 */
        }
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      본문으로 건너뛰기
    </a>

    <Navbar siteTitle={siteTitle} navItems={navItems} />

    <main id="main" class="content-width flex-1 py-8">
      <slot />
    </main>

    <Footer siteTitle={siteTitle} author={author} social={settings['site.social'] ?? {}} />
  </body>
</html>
