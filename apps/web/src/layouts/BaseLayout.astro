---
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { api, type SiteSettings } from '@lib/api';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  /** 글 상세처럼 article 로 표시해야 하는 페이지. */
  ogType?: 'website' | 'article';
  publishedAt?: number | null;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = null,
  ogType = 'website',
  publishedAt = null,
  noindex = false,
} = Astro.props;

/**
 * 사이트 설정과 네비게이션은 거의 안 바뀌는데 모든 페이지에서 필요하다.
 * API 가 잠깐 죽어도 화면은 떠야 하므로 실패하면 기본값으로 넘어간다.
 */
let settings: SiteSettings = {};
let navItems: { slug: string; label: string }[] = [];
try {
  const [settingsResult, navResult] = await Promise.all([api.site.settings(), api.site.nav()]);
  settings = settingsResult.data ?? {};
  navItems = navResult.data ?? [];
} catch (error) {
  console.error('사이트 설정을 불러오지 못했습니다', error);
}

const siteTitle = settings['site.title'] ?? 'namsu.kim';
const siteDescription = settings['site.description'] ?? '김남수의 개인 홈페이지';
const author = settings['site.author'] ?? '김남수';

const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;

/**
 * 파비콘과 공유 카드 이미지는 관리자 설정에서 온다.
 * 비어 있으면 저장소에 들어 있는 기본 파비콘을 쓴다.
 */
const faviconUrl = settings['site.faviconUrl'] || '/favicon.svg';
const faviconType = faviconUrl.endsWith('.svg')
  ? 'image/svg+xml'
  : faviconUrl.endsWith('.png')
    ? 'image/png'
    : undefined;

/*
 * iOS 는 홈 화면 아이콘으로 SVG 를 쓰지 않는다. 지정된 파비콘이 SVG 면
 * 저장소에 들어 있는 PNG 로 떨어뜨린다. 그러지 않으면 아이콘이 통째로 빈다.
 * 같은 이유로 SVG 를 모르는 오래된 브라우저를 위해 32px PNG 를 하나 더 건다.
 */
const isSvgFavicon = faviconUrl.endsWith('.svg');
const appleTouchIcon = isSvgFavicon ? '/apple-touch-icon.png' : faviconUrl;

const pageDescription = description ?? siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/*
 * 공유 카드. 글이나 프로젝트가 자체 이미지를 주면 그걸 쓰고,
 * 없으면 사이트 기본값, 그것도 없으면 저장소의 기본 카드로 떨어진다.
 * og:image 는 절대 주소여야 한다 — 상대 경로를 그대로 두면
 * 카카오톡·슬랙 같은 수집기가 이미지를 못 받아 간다.
 */
const shareImage = new URL(
  ogImage || settings['site.ogImageUrl'] || '/og-default.png',
  Astro.site ?? Astro.url.origin,
).href;
---

<!doctype html>
<html lang={(settings['site.locale'] as string) ?? 'ko'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={title ?? siteTitle} />
    {ogType === 'article' && publishedAt && (
      <meta
        property="article:published_time"
        content={new Date(publishedAt * 1000).toISOString()}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={faviconUrl} {...(faviconType ? { type: faviconType } : {})} />
    {isSvgFavicon && <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />}
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    <!--
      테마를 그리기 전에 먼저 적용한다.
      이걸 안 하면 다크 모드 사용자에게 흰 화면이 한 번 번쩍인다.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dracula' : 'winter');
        } catch {
          /* localStorage 가 막혀 있어도 기본 테마로 동작해야 한다 */
        }
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      본문으로 건너뛰기
    </a>

    <Navbar siteTitle={siteTitle} navItems={navItems} />

    <main id="main" class="content-width flex-1 py-8">
      <slot />
    </main>

    <Footer siteTitle={siteTitle} author={author} social={settings['site.social'] ?? {}} />
  </body>
</html>
