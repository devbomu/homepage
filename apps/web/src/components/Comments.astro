---
import CommentItem from '@components/CommentItem.astro';
import type { CommentNode } from '@lib/api';

interface Props {
  slug: string;
  allowComments: boolean;
  comments: CommentNode[];
  commentCount: number;
}

const { slug, allowComments, comments, commentCount } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="comments" class="mt-12" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="mb-4 text-xl font-bold">
    댓글 ({commentCount})
  </h2>

  {comments.length === 0 && (
    <p data-comment-empty class="text-base-content/60 py-6 text-sm">
      아직 댓글이 없습니다. 첫 댓글을 남겨보세요.
    </p>
  )}

  <ol data-comment-list class="space-y-4">
    {comments.map((comment) => (
      <CommentItem comment={comment} allowComments={allowComments} />
    ))}
  </ol>

  {allowComments ? (
    <form
      data-comment-form
      data-slug={slug}
      data-api={apiUrl}
      class="frost-card mt-6 space-y-3 p-5"
    >
      {/* 답글일 때만 보인다. JS 가 대상 댓글 아래로 폼을 옮긴다. */}
      <div data-reply-banner class="alert alert-info hidden py-2 text-sm">
        <span data-reply-label></span>
        <button type="button" data-reply-cancel class="btn btn-ghost btn-xs">
          취소
        </button>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div class="form-control">
          <label for="comment-author" class="label-text mb-1 block text-sm">
            이름{' '}
            <span class="text-error" aria-hidden="true">
              *
            </span>
          </label>
          <input
            id="comment-author"
            name="authorName"
            required
            maxlength="50"
            autocomplete="nickname"
            class="input input-bordered input-sm w-full"
          />
        </div>

        <div class="form-control">
          <label for="comment-email" class="label-text mb-1 block text-sm">
            이메일 (선택)
          </label>
          <input
            id="comment-email"
            name="authorEmail"
            type="email"
            maxlength="200"
            autocomplete="email"
            aria-describedby="comment-email-help"
            class="input input-bordered input-sm w-full"
          />
          <span
            id="comment-email-help"
            class="label-text-alt text-base-content/50 mt-1 block text-xs"
          >
            공개되지 않습니다. 답글 알림에만 사용합니다.
          </span>
        </div>
      </div>

      <div class="form-control">
        <label for="comment-body" class="label-text mb-1 block text-sm">
          내용{' '}
          <span class="text-error" aria-hidden="true">
            *
          </span>
        </label>
        <textarea
          id="comment-body"
          name="body"
          required
          maxlength="5000"
          rows="4"
          class="textarea textarea-bordered w-full"
        ></textarea>
      </div>

      <label class="label w-fit cursor-pointer justify-start gap-2">
        <input type="checkbox" name="isSecret" class="checkbox checkbox-sm" data-secret-toggle />
        <span class="label-text text-sm">비밀 댓글</span>
        <span data-secret-note class="text-base-content/50 text-xs">
          내용은 블로그 주인만 봅니다. 답장을 받으려면 이메일을 남겨 주세요.
        </span>
      </label>

      {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}

      <p data-comment-message role="status" class="hidden text-sm"></p>

      <div class="flex justify-end">
        <button type="submit" class="btn btn-primary btn-sm">
          댓글 남기기
        </button>
      </div>
    </form>
  ) : (
    <p class="text-base-content/60 mt-6 text-sm">이 글은 댓글을 받지 않습니다.</p>
  )}
</section>

{turnstileKey && (
  <script
    is:inline
    async
    defer
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  ></script>
)}

<script>
  const section = document.querySelector<HTMLElement>('#comments');
  const form = document.querySelector<HTMLFormElement>('[data-comment-form]');

  if (section && form) {
    // 아래 함수들 안에서도 좁혀진 타입을 유지하려고 한 번 더 묶는다.
    const root = section;
    const api = form.dataset.api!;
    const slug = encodeURIComponent(form.dataset.slug!);
    const message = form.querySelector<HTMLElement>('[data-comment-message]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const banner = form.querySelector<HTMLElement>('[data-reply-banner]')!;
    const bannerLabel = form.querySelector<HTMLElement>('[data-reply-label]')!;
    const secretToggle = form.querySelector<HTMLInputElement>('[data-secret-toggle]')!;
    const secretNote = form.querySelector<HTMLElement>('[data-secret-note]')!;
    const heading = document.querySelector<HTMLElement>('#comments-heading')!;
    const rootList = section.querySelector<HTMLOListElement>('[data-comment-list]')!;
    const emptyNotice = section.querySelector<HTMLElement>('[data-comment-empty]');
    const formHome = form.parentElement!;

    /** 서버의 CommentItem.astro 와 같은 값. 둘이 어긋나면 서버가 422 로 막는다. */
    const MAX_REPLY_DEPTH = 2;
    const SECRET_NOTE = '내용은 블로그 주인만 봅니다. 답장을 받으려면 이메일을 남겨 주세요.';

    let parentId: number | null = null;

    const show = (text: string, kind: 'ok' | 'error') => {
      message.textContent = text;
      message.className = `text-sm ${kind === 'ok' ? 'text-success' : 'text-error'}`;
    };

    const resetReply = () => {
      parentId = null;
      banner.classList.add('hidden');
      secretToggle.disabled = false;
      secretNote.textContent = SECRET_NOTE;
      formHome.appendChild(form);
    };

    /**
     * 답글 버튼은 위임으로 받는다.
     * 방금 올린 댓글에도 버튼이 생기므로, 붙일 때마다 리스너를 매는 대신
     * 영역 하나에서 받는 편이 확실하다.
     */
    section.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-reply-to]');
      if (!button) return;

      parentId = Number(button.dataset.replyTo);
      banner.classList.remove('hidden');
      bannerLabel.textContent = '이 댓글에 답글을 답니다';

      // 비밀 댓글의 답글은 서버가 강제로 비밀로 만든다.
      // 선택지를 열어두면 공개로 달 수 있다고 오해하게 된다.
      if (button.dataset.replySecret === 'true') {
        secretToggle.checked = true;
        secretToggle.disabled = true;
        secretNote.textContent = '비밀 댓글의 답글은 항상 비밀입니다.';
      }

      button.closest('li')?.appendChild(form);
      form.querySelector<HTMLTextAreaElement>('#comment-body')?.focus();
    });

    form.querySelector('[data-reply-cancel]')?.addEventListener('click', resetReply);

    const el = (tag: string, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      // 본문은 방문자가 쓴 값이다. 반드시 textContent 로만 넣는다.
      if (text != null) node.textContent = text;
      return node;
    };

    interface Created {
      id: number;
      parentId: number | null;
      authorName: string;
      body: string;
      isSecret: boolean;
    }

    /** 서버가 그리는 CommentItem.astro 와 같은 모양의 <li> 를 만든다. */
    function renderComment(data: Created, depth: number): HTMLLIElement {
      const li = document.createElement('li');
      if (depth === 0) li.className = 'frost-card p-4';

      if (data.isSecret) {
        const row = el('div', 'text-base-content/50 flex items-center gap-2 text-sm');
        const lock = el('span', undefined, '🔒');
        lock.setAttribute('aria-hidden', 'true');
        row.append(
          lock,
          el('span', undefined, '비밀 댓글입니다'),
          el('time', 'text-xs', '방금 전'),
        );
        li.append(row);
      } else {
        const row = el('div', 'flex flex-wrap items-baseline gap-2');
        row.append(
          el('span', 'font-semibold', data.authorName),
          el('time', 'text-base-content/50 text-xs', '방금 전'),
        );
        li.append(row, el('p', 'mt-2 text-sm whitespace-pre-wrap', data.body));
      }

      // 비밀 댓글에는 답글 버튼을 달지 않는다 (CommentItem.astro 와 같은 규칙).
      // 읽지도 못하는 글에 답글을 달면 아무도 못 읽는 가지만 생긴다.
      if (!data.isSecret && depth < MAX_REPLY_DEPTH) {
        const button = el('button', 'btn btn-ghost btn-xs mt-2 px-1', '답글') as HTMLButtonElement;
        button.type = 'button';
        button.dataset.replyTo = String(data.id);
        button.dataset.replySecret = data.isSecret ? 'true' : 'false';
        li.append(button);
      }
      return li;
    }

    /**
     * 올린 댓글을 새로고침 없이 화면에 끼워 넣는다.
     * 글 페이지는 엣지에 캐시되므로 다시 받아 봐도 방금 것이 없을 수 있다.
     */
    function insertComment(data: Created) {
      const parentLi =
        data.parentId == null
          ? null
          : (root
              .querySelector<HTMLLIElement>(`[data-reply-to="${data.parentId}"]`)
              ?.closest('li') ?? null);

      if (!parentLi) {
        rootList.append(renderComment(data, 0));
      } else {
        const depth = parentLi.closest('[data-comment-list]') === parentLi.parentElement ? 1 : 2;
        let replies = parentLi.querySelector<HTMLOListElement>(':scope > ol');
        if (!replies) {
          replies = document.createElement('ol');
          replies.className = 'border-base-300 mt-3 space-y-3 border-l-2 pl-4';
          parentLi.append(replies);
        }
        replies.append(renderComment(data, depth));
      }

      emptyNotice?.remove();
      const next = root.querySelectorAll('li').length;
      heading.textContent = `댓글 (${next})`;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      message.className = 'hidden text-sm';

      const data = new FormData(form);
      const payload: Record<string, unknown> = {
        authorName: String(data.get('authorName') ?? '').trim(),
        body: String(data.get('body') ?? '').trim(),
        isSecret: secretToggle.checked,
      };
      if (parentId != null) payload.parentId = parentId;

      // 빈 문자열을 보내면 서버의 이메일 형식 검사에 걸린다. 아예 빼서 보낸다.
      const email = String(data.get('authorEmail') ?? '').trim();
      if (email) payload.authorEmail = email;

      const token = data.get('cf-turnstile-response');
      if (typeof token === 'string' && token) payload.turnstileToken = token;

      try {
        const response = await fetch(`${api}/v1/posts/${slug}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await response.json().catch(() => null);

        if (response.ok) {
          show(body?.data?.message ?? '댓글이 등록되었습니다.', 'ok');
          if (body?.data?.status === 'approved') insertComment(body.data as Created);
          form.reset();
          resetReply();
          window.turnstile?.reset();
        } else {
          show(body?.error?.message ?? '등록에 실패했습니다.', 'error');
        }
      } catch {
        show('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
