---
import CommentItem from '@components/CommentItem.astro';
import type { CommentNode } from '@lib/api';

interface Props {
  slug: string;
  allowComments: boolean;
  comments: CommentNode[];
  commentCount: number;
}

const { slug, allowComments, comments, commentCount } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="comments" class="mt-12" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="mb-4 text-xl font-bold">
    댓글 {commentCount > 0 && `(${commentCount})`}
  </h2>

  {comments.length === 0 && (
    <p class="text-base-content/60 py-6 text-sm">아직 댓글이 없습니다. 첫 댓글을 남겨보세요.</p>
  )}

  <ol class="space-y-4">
    {comments.map((comment) => (
      <CommentItem comment={comment} allowComments={allowComments} />
    ))}
  </ol>

  {allowComments ? (
    <form
      data-comment-form
      data-slug={slug}
      data-api={apiUrl}
      class="frost-card mt-6 space-y-3 p-5"
    >
      {/* 답글일 때만 보인다. JS 가 대상 댓글 아래로 폼을 옮긴다. */}
      <div data-reply-banner class="alert alert-info hidden py-2 text-sm">
        <span data-reply-label></span>
        <button type="button" data-reply-cancel class="btn btn-ghost btn-xs">
          취소
        </button>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div class="form-control">
          <label for="comment-author" class="label-text mb-1 block text-sm">
            이름{' '}
            <span class="text-error" aria-hidden="true">
              *
            </span>
          </label>
          <input
            id="comment-author"
            name="authorName"
            required
            maxlength="50"
            autocomplete="nickname"
            class="input input-bordered input-sm w-full"
          />
        </div>

        <div class="form-control">
          <label for="comment-email" class="label-text mb-1 block text-sm">
            이메일 (선택)
          </label>
          <input
            id="comment-email"
            name="authorEmail"
            type="email"
            maxlength="200"
            autocomplete="email"
            aria-describedby="comment-email-help"
            class="input input-bordered input-sm w-full"
          />
          <span
            id="comment-email-help"
            class="label-text-alt text-base-content/50 mt-1 block text-xs"
          >
            공개되지 않습니다. 답글 알림에만 사용합니다.
          </span>
        </div>
      </div>

      <div class="form-control">
        <label for="comment-body" class="label-text mb-1 block text-sm">
          내용{' '}
          <span class="text-error" aria-hidden="true">
            *
          </span>
        </label>
        <textarea
          id="comment-body"
          name="body"
          required
          maxlength="5000"
          rows="4"
          class="textarea textarea-bordered w-full"
        ></textarea>
      </div>

      <label class="label w-fit cursor-pointer justify-start gap-2">
        <input type="checkbox" name="isSecret" class="checkbox checkbox-sm" data-secret-toggle />
        <span class="label-text text-sm">비밀 댓글</span>
        <span data-secret-note class="text-base-content/50 text-xs">
          내용은 블로그 주인만 봅니다. 답장을 받으려면 이메일을 남겨 주세요.
        </span>
      </label>

      {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}

      <p data-comment-message role="status" class="hidden text-sm"></p>

      <div class="flex justify-end">
        <button type="submit" class="btn btn-primary btn-sm">
          댓글 남기기
        </button>
      </div>
    </form>
  ) : (
    <p class="text-base-content/60 mt-6 text-sm">이 글은 댓글을 받지 않습니다.</p>
  )}
</section>

{turnstileKey && (
  <script
    is:inline
    async
    defer
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  ></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-comment-form]');

  if (form) {
    const api = form.dataset.api!;
    const slug = encodeURIComponent(form.dataset.slug!);
    const message = form.querySelector<HTMLElement>('[data-comment-message]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const banner = form.querySelector<HTMLElement>('[data-reply-banner]')!;
    const bannerLabel = form.querySelector<HTMLElement>('[data-reply-label]')!;
    const secretToggle = form.querySelector<HTMLInputElement>('[data-secret-toggle]')!;
    const secretNote = form.querySelector<HTMLElement>('[data-secret-note]')!;
    const formHome = form.parentElement!;

    let parentId: number | null = null;

    const show = (text: string, kind: 'ok' | 'error') => {
      message.textContent = text;
      message.className = `text-sm ${kind === 'ok' ? 'text-success' : 'text-error'}`;
    };

    const resetReply = () => {
      parentId = null;
      banner.classList.add('hidden');
      secretToggle.disabled = false;
      secretNote.textContent = '내용은 블로그 주인만 봅니다. 답장을 받으려면 이메일을 남겨 주세요.';
      formHome.appendChild(form);
    };

    // 답글 버튼: 폼을 대상 댓글 아래로 옮긴다.
    // 댓글마다 폼을 두지 않아 마크업이 가볍고, 입력값도 유지된다.
    for (const button of document.querySelectorAll<HTMLElement>('[data-reply-to]')) {
      button.addEventListener('click', () => {
        parentId = Number(button.dataset.replyTo);
        banner.classList.remove('hidden');
        bannerLabel.textContent = '이 댓글에 답글을 답니다';

        // 비밀 댓글의 답글은 서버가 강제로 비밀로 만든다.
        // 선택지를 열어두면 공개로 달 수 있다고 오해하게 된다.
        if (button.dataset.replySecret === 'true') {
          secretToggle.checked = true;
          secretToggle.disabled = true;
          secretNote.textContent = '비밀 댓글의 답글은 항상 비밀입니다.';
        }

        button.closest('li')?.appendChild(form);
        form.querySelector<HTMLTextAreaElement>('#comment-body')?.focus();
      });
    }

    form.querySelector('[data-reply-cancel]')?.addEventListener('click', resetReply);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      message.className = 'hidden text-sm';

      const data = new FormData(form);
      const payload: Record<string, unknown> = {
        authorName: String(data.get('authorName') ?? '').trim(),
        body: String(data.get('body') ?? '').trim(),
        isSecret: secretToggle.checked,
      };
      if (parentId != null) payload.parentId = parentId;

      // 빈 문자열을 보내면 서버의 이메일 형식 검사에 걸린다. 아예 빼서 보낸다.
      const email = String(data.get('authorEmail') ?? '').trim();
      if (email) payload.authorEmail = email;

      const token = data.get('cf-turnstile-response');
      if (typeof token === 'string' && token) payload.turnstileToken = token;

      try {
        const response = await fetch(`${api}/v1/posts/${slug}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await response.json().catch(() => null);

        if (response.ok) {
          show(body?.data?.message ?? '댓글이 등록되었습니다.', 'ok');
          form.reset();
          resetReply();
          window.turnstile?.reset();
        } else {
          show(body?.error?.message ?? '등록에 실패했습니다.', 'error');
        }
      } catch {
        show('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
