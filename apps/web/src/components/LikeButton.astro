---
interface Props {
  slug: string;
  initialCount: number;
}

const { slug, initialCount } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<!--
  좋아요는 방문자마다 상태가 달라 서버에서 미리 그릴 수 없다
  (그렸다가는 엣지 캐시에 남의 상태가 섞인다).
  개수만 서버에서 내보내고, 내가 눌렀는지는 붙은 뒤에 물어본다.
-->
<button
  type="button"
  data-like-button
  data-slug={slug}
  data-api={apiUrl}
  class="btn btn-outline btn-sm gap-2"
  aria-pressed="false"
  aria-label="이 글 좋아요"
>
  <span data-like-icon aria-hidden="true">
    ♡
  </span>
  <span data-like-count>{initialCount}</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-like-button]');
  if (button) {
    const api = button.dataset.api!;
    const slug = encodeURIComponent(button.dataset.slug!);
    const icon = button.querySelector<HTMLElement>('[data-like-icon]')!;
    const count = button.querySelector<HTMLElement>('[data-like-count]')!;

    const render = (liked: boolean, likeCount: number) => {
      icon.textContent = liked ? '♥' : '♡';
      count.textContent = String(likeCount);
      button.setAttribute('aria-pressed', String(liked));
      button.classList.toggle('btn-primary', liked);
      button.classList.toggle('btn-outline', !liked);
    };

    // 캐시된 HTML 에는 내 상태가 없으므로 붙자마자 물어본다.
    fetch(`${api}/v1/posts/${slug}/like`)
      .then((r) => (r.ok ? r.json() : null))
      .then((body) => body && render(body.data.liked, body.data.likeCount))
      .catch(() => {
        /* 실패해도 개수는 서버가 그려둔 값이 남는다 */
      });

    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const response = await fetch(`${api}/v1/posts/${slug}/like`, { method: 'POST' });
        if (response.ok) {
          const body = await response.json();
          render(body.data.liked, body.data.likeCount);
        }
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
