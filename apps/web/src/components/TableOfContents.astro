---
import type { TocEntry } from '@lib/toc';

interface Props {
  entries: TocEntry[];
}

const { entries } = Astro.props;
---

{entries.length > 1 && (
  <nav class="frost-card sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto p-4 lg:block" aria-label="목차">
    <p class="mb-2 text-sm font-semibold">목차</p>
    <ul class="space-y-1 text-sm">
      {entries.map((entry) => (
        <li class:list={[entry.level === 3 && 'ml-3']}>
          <a
            href={`#${entry.id}`}
            data-toc-link={entry.id}
            class="text-base-content/60 hover:text-primary line-clamp-2 transition-colors"
          >
            {entry.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // 지금 화면에 보이는 제목을 목차에서 강조한다.
  const links = new Map<string, HTMLElement>();
  for (const link of document.querySelectorAll<HTMLElement>('[data-toc-link]')) {
    links.set(link.dataset.tocLink!, link);
  }

  if (links.size > 0) {
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el != null);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links.values()) link.classList.remove('text-primary', 'font-semibold');
          links.get(entry.target.id)?.classList.add('text-primary', 'font-semibold');
        }
      },
      // 화면 위쪽 1/4 지점을 지나는 제목을 "현재 위치"로 본다.
      { rootMargin: '-80px 0px -75% 0px' },
    );

    for (const heading of headings) observer.observe(heading);
  }
</script>
