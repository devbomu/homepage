---
import { safeLink } from '@lib/url';
import BaseLayout from '@layouts/BaseLayout.astro';
import { api, type Project } from '@lib/api';

let projects: Project[] = [];
try {
  projects = (await api.projects.list()).data ?? [];
} catch (error) {
  console.error('프로젝트를 불러오지 못했습니다', error);
}

const period = (project: Project) => {
  if (!project.startedOn) return null;
  const start = project.startedOn.slice(0, 7).replace('-', '.');
  const end = project.endedOn ? project.endedOn.slice(0, 7).replace('-', '.') : '진행 중';
  return `${start} – ${end}`;
};
---

<BaseLayout title="프로젝트" description="만들어 온 것들">
  <h1 class="mb-6 text-2xl font-bold">프로젝트</h1>

  {projects.length === 0 ? (
    <p class="text-base-content/60 py-12 text-center text-sm">아직 공개한 프로젝트가 없습니다.</p>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2">
      {projects.map((project) => (
        <article id={project.slug} class="frost-card scroll-mt-20 overflow-hidden">
          {project.thumbnailUrl && (
            <img
              src={project.thumbnailUrl}
              alt=""
              class="aspect-[16/9] w-full object-cover"
              loading="lazy"
            />
          )}
          <div class="space-y-3 p-5">
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-lg font-bold">
                <a href={`/projects/${encodeURIComponent(project.slug)}`} class="link link-hover">
                  {project.title}
                </a>
              </h2>
              {project.isFeatured && (
                <span class="badge badge-primary badge-sm shrink-0">대표</span>
              )}
            </div>

            {period(project) && (
              <p class="text-base-content/50 text-xs">
                {period(project)}
                {project.role && ` · ${project.role}`}
              </p>
            )}

            {project.summary && <p class="text-base-content/70 text-sm">{project.summary}</p>}

            {project.techStack.length > 0 && (
              <div class="flex flex-wrap gap-1">
                {project.techStack.map((tech) => (
                  <span class="badge badge-ghost badge-sm">{tech}</span>
                ))}
              </div>
            )}

            <div class="flex gap-2 pt-1">
              {safeLink(project.repoUrl) && (
                <a
                  href={safeLink(project.repoUrl)}
                  class="btn btn-outline btn-xs"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  저장소
                </a>
              )}
              {safeLink(project.demoUrl) && (
                <a
                  href={safeLink(project.demoUrl)}
                  class="btn btn-primary btn-xs"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  보러 가기
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}
</BaseLayout>
