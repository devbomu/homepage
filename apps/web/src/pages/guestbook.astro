---
/**
 * 방명록.
 *
 * 댓글과 달리 답글이 없다. 한 줄로 쭉 쌓이기만 한다.
 * 본문은 마크다운으로 렌더하지 않는다 — 평문으로만 다뤄야 안전하다.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { api, type GuestbookEntry } from '@lib/api';
import { formatRelative, toIso } from '@lib/format';

let entries: GuestbookEntry[] = [];
let total = 0;
try {
  const result = await api.guestbook.list();
  entries = result.data ?? [];
  total = result.meta?.total ?? entries.length;
} catch (error) {
  console.error('방명록을 불러오지 못했습니다', error);
}

const apiUrl = import.meta.env.PUBLIC_API_URL;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title="방명록" description="지나가신 흔적을 남겨 주세요.">
  <div class="mx-auto max-w-2xl">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">방명록</h1>
      <p class="text-base-content/60 mt-2 text-sm">
        지나가신 흔적을 남겨 주세요. 남기신 글은 바로 보입니다.
      </p>
    </header>

    <form data-guestbook-form data-api={apiUrl} class="frost-card mb-8 space-y-3 p-5">
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="form-control">
          <label for="gb-author" class="label-text mb-1 block text-sm">
            이름{' '}
            <span class="text-error" aria-hidden="true">
              *
            </span>
          </label>
          <input
            id="gb-author"
            name="authorName"
            required
            maxlength="50"
            autocomplete="nickname"
            class="input input-bordered input-sm w-full"
          />
        </div>

        <div class="form-control">
          <label for="gb-website" class="label-text mb-1 block text-sm">
            홈페이지 (선택)
          </label>
          <input
            id="gb-website"
            name="authorWebsite"
            type="url"
            maxlength="500"
            placeholder="https://"
            autocomplete="url"
            class="input input-bordered input-sm w-full"
          />
        </div>
      </div>

      <div class="form-control">
        <label for="gb-email" class="label-text mb-1 block text-sm">
          이메일 (선택)
        </label>
        <input
          id="gb-email"
          name="authorEmail"
          type="email"
          maxlength="200"
          autocomplete="email"
          aria-describedby="gb-email-help"
          class="input input-bordered input-sm w-full"
        />
        <span id="gb-email-help" class="label-text-alt text-base-content/50 mt-1 block text-xs">
          공개되지 않습니다.
        </span>
      </div>

      <div class="form-control">
        <label for="gb-body" class="label-text mb-1 block text-sm">
          내용{' '}
          <span class="text-error" aria-hidden="true">
            *
          </span>
        </label>
        <textarea
          id="gb-body"
          name="body"
          required
          maxlength="2000"
          rows="4"
          class="textarea textarea-bordered w-full"
        ></textarea>
      </div>

      {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}

      <p data-guestbook-message role="status" class="hidden text-sm"></p>

      <div class="flex justify-end">
        <button type="submit" class="btn btn-primary btn-sm">
          남기기
        </button>
      </div>
    </form>

    <h2 id="guestbook-heading" class="mb-4 text-xl font-bold">
      남겨주신 글 ({total})
    </h2>

    {entries.length === 0 && (
      <p data-guestbook-empty class="text-base-content/60 py-6 text-sm">
        아직 남겨주신 글이 없습니다. 첫 번째가 되어 주세요.
      </p>
    )}

    <ol data-guestbook-list class="space-y-3">
      {entries.map((entry) => (
        <li class="frost-card p-4">
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="font-semibold">
              {entry.authorWebsite ? (
                <a
                  href={entry.authorWebsite}
                  class="link link-hover"
                  rel="nofollow noopener noreferrer"
                  target="_blank"
                >
                  {entry.authorName}
                </a>
              ) : (
                entry.authorName
              )}
            </span>
            <time class="text-base-content/50 text-xs" datetime={toIso(entry.createdAt)}>
              {formatRelative(entry.createdAt)}
            </time>
          </div>
          <p class="mt-2 text-sm whitespace-pre-wrap">{entry.body}</p>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

{turnstileKey && (
  <script
    is:inline
    async
    defer
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  ></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-guestbook-form]');

  if (form) {
    const api = form.dataset.api!;
    const message = form.querySelector<HTMLElement>('[data-guestbook-message]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const list = document.querySelector<HTMLOListElement>('[data-guestbook-list]')!;
    const heading = document.querySelector<HTMLElement>('#guestbook-heading')!;
    const empty = document.querySelector<HTMLElement>('[data-guestbook-empty]');

    const show = (text: string, kind: 'ok' | 'error') => {
      message.textContent = text;
      message.className = `text-sm ${kind === 'ok' ? 'text-success' : 'text-error'}`;
    };

    const el = (tag: string, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      // 방문자가 쓴 값이다. 반드시 textContent 로만 넣는다.
      if (text != null) node.textContent = text;
      return node;
    };

    /**
     * 방금 남긴 글을 새로고침 없이 맨 위에 끼워 넣는다.
     * 이 페이지는 엣지에 캐시되므로 다시 받아 봐도 방금 것이 없을 수 있다.
     */
    function insert(data: { authorName: string; authorWebsite: string | null; body: string }) {
      const li = el('li', 'frost-card p-4');
      const head = el('div', 'flex flex-wrap items-baseline gap-2');
      const name = el('span', 'font-semibold');

      if (data.authorWebsite) {
        const link = el('a', 'link link-hover', data.authorName) as HTMLAnchorElement;
        link.href = data.authorWebsite;
        link.rel = 'nofollow noopener noreferrer';
        link.target = '_blank';
        name.append(link);
      } else {
        name.textContent = data.authorName;
      }

      head.append(name, el('time', 'text-base-content/50 text-xs', '방금 전'));
      li.append(head, el('p', 'mt-2 text-sm whitespace-pre-wrap', data.body));
      list.prepend(li);

      empty?.remove();
      heading.textContent = `남겨주신 글 (${list.children.length})`;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      message.className = 'hidden text-sm';

      const data = new FormData(form);
      const payload: Record<string, unknown> = {
        authorName: String(data.get('authorName') ?? '').trim(),
        body: String(data.get('body') ?? '').trim(),
      };

      // 빈 문자열을 보내면 서버의 형식 검사에 걸린다. 아예 빼서 보낸다.
      const email = String(data.get('authorEmail') ?? '').trim();
      if (email) payload.authorEmail = email;
      const website = String(data.get('authorWebsite') ?? '').trim();
      if (website) payload.authorWebsite = website;

      const token = data.get('cf-turnstile-response');
      if (typeof token === 'string' && token) payload.turnstileToken = token;

      try {
        const response = await fetch(`${api}/v1/guestbook`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await response.json().catch(() => null);

        if (response.ok) {
          show(body?.data?.message ?? '남겼습니다.', 'ok');
          if (body?.data?.status === 'approved') insert(body.data);
          form.reset();
          window.turnstile?.reset();
        } else {
          show(body?.error?.message ?? '남기지 못했습니다.', 'error');
        }
      } catch {
        show('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
