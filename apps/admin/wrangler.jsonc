{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namsu-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },

  // Access 는 호스트 이름 단위로 적용된다. 커스텀 도메인만 정책으로 감싸면
  // *.workers.dev 주소가 인증 없이 열린 채로 남는다. 아예 만들지 않는다.
  // preview_urls 도 같은 이유로 끈다 (버전마다 공개 URL 이 하나씩 생긴다).
  "workers_dev": false,
  "preview_urls": false,

  "routes": [{ "pattern": "admin.namsu.kim", "custom_domain": true }],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // SPA 라우팅: 없는 경로는 index.html 로 돌려보낸다.
    "not_found_handling": "single-page-application"
  },

  "vars": {
    // 프록시가 요청을 넘길 API 주소.
    "API_ORIGIN": "https://api.namsu.kim"
  }
}
