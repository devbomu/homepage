{
  // 이 설정은 마이그레이션 실행 전용이다 (배포되는 Worker 가 아니다).
  // `pnpm db:migrate:local` / `pnpm db:migrate:remote` 가 이 파일을 읽는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namsu-db-migrator",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namsu-kim",
      // 아래 ID 는 `wrangler d1 create namsu-kim` 실행 후 출력되는 값으로 교체한다.
      // 공개 저장소지만 D1 database id 는 비밀값이 아니다 (API 토큰 없이는 접근 불가).
      "database_id": "3a8bfd8d-6140-495c-af72-7fe726266d7f",
      "migrations_dir": "migrations"
    }
  ]
}
