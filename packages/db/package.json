{
  "name": "@namsu/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply namsu-kim --local --persist-to ../../.wrangler-state",
    "migrate:remote": "wrangler d1 migrations apply namsu-kim --remote",
    "seed:local": "wrangler d1 execute namsu-kim --local --persist-to ../../.wrangler-state --file=./seed.sql",
    "reset:local": "rm -rf ../../.wrangler-state && pnpm migrate:local && pnpm seed:local",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "exec:local": "wrangler d1 execute namsu-kim --local --persist-to ../../.wrangler-state"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.2"
  }
}
